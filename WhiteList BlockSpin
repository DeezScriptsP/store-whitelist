local function updatePlayerListUI()
    for _, child in ipairs(NearbyScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local isFriend = (FriendStatus[p.Name] == true)
            local isHitboxOn = (HitboxStatus[p.Name] == true)
            local pRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            local distText = ""
            
            if lRoot and pRoot then
                local dist = math.floor((lRoot.Position - pRoot.Position).Magnitude)
                distText = " (" .. dist .. "m)"
            end

            local rowFrame = Instance.new("Frame", NearbyScroll)
            rowFrame.Size = UDim2.new(1, 0, 0, 24)
            rowFrame.BackgroundTransparency = 1

            local nameBtn = Instance.new("TextButton", rowFrame)
            nameBtn.Size = UDim2.new(0.60, 0, 1, 0)
            nameBtn.BackgroundTransparency = 1
            nameBtn.Text = "• " .. p.Name .. distText
            nameBtn.Font = Enum.Font.GothamMedium
            nameBtn.TextSize = 9
            nameBtn.TextXAlignment = Enum.TextXAlignment.Left
            nameBtn.TextColor3 = isFriend and FRIEND_COLOR or Color3.fromRGB(200, 200, 205)

            nameBtn.MouseButton1Click:Connect(function()
                FriendStatus[p.Name] = not FriendStatus[p.Name]
                if p.Character then applyESP(p.Character) end
                updatePlayerListUI()
            end)

            local hbBtn = Instance.new("TextButton", rowFrame)
            hbBtn.Size = UDim2.new(0.38, 0, 0.85, 0)
            hbBtn.Position = UDim2.new(0.60, 0, 0.07, 0)
            hbBtn.BackgroundColor3 = isHitboxOn and Color3.fromRGB(255, 69, 58) or Color3.fromRGB(48, 48, 54)
            hbBtn.Text = isHitboxOn and "Hitbox: ON" or "Hitbox: OFF"
            hbBtn.Font = Enum.Font.GothamBold
            hbBtn.TextSize = 8
            hbBtn.TextColor3 = IOS_TEXT_COLOR
            Instance.new("UICorner", hbBtn).CornerRadius = UDim.new(0, 6)

            hbBtn.MouseButton1Click:Connect(function()
                HitboxStatus[p.Name] = not HitboxStatus[p.Name]
                updatePlayerHitbox(p)
                updatePlayerListUI()
            end)
        end
    end
    NearbyScroll.CanvasSize = UDim2.new(0, 0, 0, #NearbyScroll:GetChildren() * 26)
end

