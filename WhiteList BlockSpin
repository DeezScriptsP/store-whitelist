                    -- تأخير متوازن ومحسوب (0.12 ثانية) يمنع اللعبة من الانهيار بعد الصيدة الخامسة
                    task.wait(0.12)
                    
                    local currentLevel = SliderMinigame.level and SliderMinigame.level.get()
                    if currentLevel then
                        SliderMinigame.level.set(currentLevel + 1)
                    end
                end
                task.wait(0.08)
            end
        end
    end)
    isFishingProcess = false
end

