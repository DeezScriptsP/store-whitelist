    end
    if FOVCircle then
        FOVCircle.Visible = _G.RPG_Aim_Enabled or _G.Sniper_Aim_Enabled
        FOVCircle.Radius = FOV_RADIUS
    end
    RPGAimBtn.Text = _G.RPG_Aim_Enabled and "RPG Aim: ON [F]" or "RPG Aim: OFF [F]"
    RPGAimBtn.BackgroundColor3 = _G.RPG_Aim_Enabled and IOS_ACCENT_COLOR or Color3.fromRGB(48, 48, 54)
end

local function toggleSniperAim()
    _G.Sniper_Aim_Enabled = not _G.Sniper_Aim_Enabled
    if _G.Sniper_Aim_Enabled then
        _G.RPG_Aim_Enabled = false
        RPGAimBtn.Text = "RPG Aim: OFF [F]"
        RPGAimBtn.BackgroundColor3 = Color3.fromRGB(48, 48, 54)
    end
    if FOVCircle then
        FOVCircle.Visible = _G.RPG_Aim_Enabled or _G.Sniper_Aim_Enabled
        FOVCircle.Radius = SNIPER_FOV
    end
    SniperAimBtn.Text = _G.Sniper_Aim_Enabled and "Sniper Aim: ON [Q]" or "Sniper Aim: OFF [Q]"
    SniperAimBtn.BackgroundColor3 = _G.Sniper_Aim_Enabled and IOS_SUCCESS_COLOR or Color3.fromRGB(48, 48, 54)
end

RPGAimBtn.MouseButton1Click:Connect(toggleRPGAim)
SniperAimBtn.MouseButton1Click:Connect(toggleSniperAim)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then toggleRPGAim()
    elseif input.KeyCode == Enum.KeyCode.Q then toggleSniperAim() end
end)

print("تم دمج سكربت الصيد الذكي داخل واجهة Royal XPE بنجاح!")
