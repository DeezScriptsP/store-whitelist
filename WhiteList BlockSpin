local isFishingProcess = false
local function completeMinigameOnce()
    if isFishingProcess then return end
    isFishingProcess = true
    pcall(function()
        if success and SliderMinigame and SliderMinigame.enabled and SliderMinigame.enabled.get() then
            -- توسيع النطاق الأخضر برمجياً لتسهيل الالتقاط
            if SliderMinigame.target_size and SliderMinigame.target_size.set then
                pcall(function() SliderMinigame.target_size.set(0.65) end)
            end

            while SliderMinigame.enabled and SliderMinigame.enabled.get() do
                local targetPos = SliderMinigame.target_pos and SliderMinigame.target_pos.get()
                if targetPos then
                    -- محاذاة السهم بدقة كاملة وبدون قفزات مفاجئة
