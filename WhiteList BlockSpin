local function updatePlayerHitbox(p)
    if not p.Character then return end
    local leftLegs, rightLegs, torsos = {}, {}, {}
    for _, part in ipairs(p.Character:GetChildren()) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            if name:find("left") and (name:find("leg") or name:find("foot") or name:find("shin")) then
                table.insert(leftLegs, part)
            elseif name:find("right") and (name:find("leg") or name:find("foot") or name:find("shin")) then
                table.insert(rightLegs, part)
            elseif name:find("torso") or name:find("upper") or name:find("lower") or name == "torso" then
                table.insert(torsos, part)
            end
        end
    end
    
    if HitboxStatus[p.Name] then
        for _, leg in ipairs(leftLegs) do leg.Size = Vector3.new(1, 2, 1) leg.Transparency = 0 leg.CanCollide = true end
        for _, leg in ipairs(rightLegs) do leg.Size = Vector3.new(1, 2, 1) leg.Transparency = 0 leg.CanCollide = true end
        for _, torso in ipairs(torsos) do
            local tSz = _G.TorsoSizeMultiplier
            torso.Size = Vector3.new(tSz, tSz, tSz)
            torso.Transparency = 0.55
            torso.Color = HITBOX_COLOR
            torso.CanCollide = false
        end
    else
        for _, leg in ipairs(leftLegs) do leg.Size = Vector3.new(1, 2, 1) leg.Transparency = 0 leg.Color = Color3.fromRGB(100, 100, 100) leg.CanCollide = true end
        for _, leg in ipairs(rightLegs) do leg.Size = Vector3.new(1, 2, 1) leg.Transparency = 0 leg.Color = Color3.fromRGB(100, 100, 100) leg.CanCollide = true end
        for _, torso in ipairs(torsos) do torso.Size = Vector3.new(2, 1, 1) torso.Transparency = 0 torso.Color = Color3.fromRGB(124, 92, 70) torso.CanCollide = true end
    end
end

